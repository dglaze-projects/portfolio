---
import PageHead from '../components/PageHead.astro';
import PortfolioHeader from '../components/PortfolioHeader.astro';
import PortfolioFooter from '../components/PortfolioFooter.astro';
import '@fontsource-variable/inter';
---
<!doctype html>
<html lang="en"><PageHead title="Contact — Deanna Glaze" description="Get in touch with Deanna Glaze about product design, leadership opportunities, and collaboration." />
<body><a class="skip" href="#main">Skip to content</a><div class="page">
<PortfolioHeader active="contact" />
<main id="main"><section class="contact"><div><h1>Let’s connect.</h1><div class="monkey-introduction"><img class="monkeyshine" src="/images/exploration/monkeyshine-wayfarer.png" width="1280" height="1280" alt="Monkeyshine wearing black Wayfarer-style glasses"/><div class="welcome-callout"><p class="intro-copy">Interested in collaborating, or want to talk through a hard design problem? Tell me what you’re working on.</p><p class="alternate">Prefer to connect on <a href="https://www.linkedin.com/in/deannaglaze" target="_blank" rel="noopener noreferrer">LinkedIn</a>? That works too.</p></div></div></div><form class="contact-form" method="POST" action="/api/contact">
        <p class="field">
          <label for="cf-name">Name</label>
          <input id="cf-name" name="name" type="text" required maxlength="200" autocomplete="name" />
        </p>
        <p class="field">
          <label for="cf-email">Email</label>
          <input id="cf-email" name="email" type="email" required maxlength="200" autocomplete="email" />
        </p>
        <p class="field">
          <label for="cf-message">Message</label>
          <textarea id="cf-message" name="message" required maxlength="5000" rows="7"></textarea>
        </p>
        <!-- Honeypot: hidden from people, irresistible to bots -->
        <p class="field field--hp" aria-hidden="true">
          <label for="cf-company">Company</label>
          <input id="cf-company" name="company" type="text" tabindex="-1" autocomplete="off" />
        </p>
        <p class="form-note">All fields are required.</p><p class="contact-form__actions">
          <button class="button" type="submit">
            Send message <span aria-hidden="true">→</span>
          </button>
        </p>
      <p id="form-status" role="status" aria-live="polite" tabindex="-1"></p></form></section></main><PortfolioFooter /></div><style is:global>:root{--ink:#29282d;--muted:#66616b;--plum:#853b72;--line:#e4dfe4}*{box-sizing:border-box}body{padding-bottom:68px;margin:0;background:white;color:var(--ink);font:17px/29px 'Inter Variable',Arial,sans-serif}.page{max-width:1472px;padding:0 80px;margin:auto}a{color:inherit;text-decoration:none}a:hover{text-decoration:underline}a:focus-visible{outline:2px solid var(--plum);outline-offset:5px}h1,h2,p{margin:0}header{height:88px;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between}.wordmark{font-size:18px;font-weight:400;letter-spacing:-.2px}nav{display:flex;gap:36px;font-size:13px;line-height:normal;color:var(--muted)}nav .active{color:var(--plum);font-weight:500;border-bottom:2px solid var(--plum);padding-bottom:8px;margin-bottom:-10px}footer{position:fixed;bottom:0;left:50%;transform:translateX(-50%);width:calc(100% - 160px);max-width:1312px;height:44px;display:flex;align-items:center;justify-content:space-between;border-top:1px solid var(--line);background:#fff;z-index:10;font-size:13px;font-weight:500;color:var(--muted)}footer a{display:flex;align-items:center;min-height:44px}footer a:last-child{color:var(--plum)}.skip{position:fixed;transform:translateY(-200%);background:white;padding:10px;z-index:20}.skip:focus{transform:none}

.contact{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:88px;padding:56px 0 64px;align-items:start}
h1{font:400 44px/1.4 'Inter Variable',Arial,sans-serif;letter-spacing:-.02em;max-width:12ch;margin-bottom:28px}
.monkey-introduction{display:flex;align-items:flex-start;gap:18px;margin-top:36px}.monkeyshine{transform:scaleX(-1);width:140px;height:170px;object-fit:contain;flex-shrink:0;margin-top:20px}.welcome-callout{position:relative;background:#f7f0f5;border-radius:12px;padding:24px;flex:1;min-width:0}.welcome-callout::before{content:"";position:absolute;left:-10px;top:45px;width:20px;height:20px;background:#f7f0f5;transform:rotate(45deg)}.intro-copy{font-size:18px;line-height:29px;color:var(--muted);max-width:39ch}
.alternate{margin-top:24px;font-size:14px;line-height:23px;color:var(--muted)}.alternate a{color:var(--plum);text-decoration:underline;text-underline-offset:3px}
.contact-form{display:grid;gap:24px;padding-top:8px;max-width:600px;width:100%}.field{display:grid;gap:10px}.field label{font-size:13px;font-weight:500;line-height:20px}
.field input,.field textarea{width:100%;border:1px solid var(--line);border-radius:4px;background:#fdfbfd;padding:12px 14px;color:var(--ink);font:16px/24px 'Inter Variable',Arial,sans-serif}.field input{height:48px}.field textarea{min-height:180px;resize:vertical}.field input:focus,.field textarea:focus{outline:2px solid var(--plum);outline-offset:2px}.field--hp{position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden}
.form-note{font-size:12px;line-height:18px;color:var(--muted);margin-top:-8px}.button{border:0;display:inline-flex;align-items:center;gap:32px;background:var(--plum);color:white;padding:0 20px;height:44px;border-radius:4px;font:500 13px 'Inter Variable',Arial,sans-serif;cursor:pointer}.button:hover{background:#713261}.button:focus-visible{outline:2px solid var(--plum);outline-offset:4px}.button:disabled{opacity:.65;cursor:wait}#form-status{font-size:14px;line-height:23px;color:var(--plum)}#form-status:empty{display:none}
@media(min-width:761px) and (max-width:1100px){.monkey-introduction{flex-direction:column;gap:12px;margin-top:24px}.monkeyshine{width:120px;height:140px;margin-top:0}.welcome-callout::before{left:50px;top:-10px}}
@media(max-width:1200px){.page{padding:0 40px}.contact{gap:48px}footer{width:calc(100% - 80px)}}
@media(max-width:760px){body{padding-bottom:0}.page{padding:0 22px}header{height:76px}.wordmark{font-size:18px}nav{gap:20px}.contact{grid-template-columns:1fr;gap:32px;padding:30px 0}h1{font-size:34px;line-height:1.35;letter-spacing:-.015em;max-width:12ch;margin-bottom:24px}.monkey-introduction{gap:12px;margin-top:24px}.monkeyshine{width:76px;height:110px;margin-top:16px}.welcome-callout{padding:20px}.intro-copy{font-size:16px;line-height:26px}.alternate{margin-top:18px}.contact-form{padding:0;max-width:none}footer{position:static;transform:none;width:100%;margin-top:24px;height:48px}}
h1,h2,h3{text-wrap:balance}
</style><script>
const form = document.querySelector<HTMLFormElement>('.contact-form');
form?.addEventListener('submit', async (event) => {
  event.preventDefault();
  const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
  const status = document.querySelector<HTMLElement>('#form-status')!;
  button.disabled = true;
  status.textContent = 'Sending your message…';
  try {
    const response = await fetch(form.action, { method: 'POST', body: new FormData(form) });
    if (!response.ok || new URL(response.url).pathname.replace(/\/$/, '') !== '/contact/thanks') throw new Error('Message not sent');
    status.textContent = "Thanks for reaching out. Your message is on its way to my inbox.";
    form.reset();
  } catch {
    status.textContent = "Your message couldn’t be sent. Please try again, or connect with me on LinkedIn. Your message is still here.";
  } finally {
    button.disabled = false;
    status.focus();
  }
});
</script></body></html>