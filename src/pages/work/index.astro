---
import PageHead from '../../components/PageHead.astro';
import PortfolioHeader from '../../components/PortfolioHeader.astro';
import PortfolioFooter from '../../components/PortfolioFooter.astro';
import '@fontsource-variable/inter';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
const projects = (await getCollection('work', ({data}) => !data.draft)).sort((a,b)=>a.data.order-b.data.order);
---
<!doctype html>
<html lang="en"><PageHead title="Work — Deanna Glaze" description="Selected case studies across AI, digital health, publishing, and brand." />
<body><a class="skip" href="#main">Skip to content</a><div class="page">
<PortfolioHeader active="work" />
<main id="main"><h1>Explore the work.</h1><p class="intro">Selected case studies across AI, digital health, publishing, and brand.</p><div class="work-grid">{projects.map(({id,data})=><a class="work-card" href={`/work/${id}`}>{data.cover && <Image src={data.cover} alt={data.coverAlt || ''} widths={[480,800,1200]} sizes="(max-width:760px) 100vw, 50vw" loading="lazy"/>}<p class="client">{data.client}</p><h2>{data.shortTitle || data.title}</h2><p>{data.tagline}</p><span class="read">Read case study ↗</span></a>)}<a class="work-card protected-card" href="/work/redshift-bio"><div class="private-preview"><span aria-hidden="true">◇</span><span>Password protected</span></div><p class="client">Redshift Bio</p><h2>Experience design for life sciences</h2><p>A private case study. Enter the password to explore the work.</p><span class="read">View protected case study ↗</span></a></div></main><PortfolioFooter /></div><style is:global>:root{--ink:#29282d;--muted:#66616b;--plum:#853b72;--line:#e4dfe4}*{box-sizing:border-box}body{padding-bottom:68px;margin:0;background:white;color:var(--ink);font:18px/29px 'Inter Variable',Arial,sans-serif}.page{max-width:1472px;padding:0 80px;margin:auto}a{color:inherit;text-decoration:none}a:hover{text-decoration:underline}a:focus-visible{outline:2px solid var(--plum);outline-offset:5px}h1,h2,p{margin:0}header{height:88px;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between}.wordmark{font-size:19px;font-weight:600;letter-spacing:-.6px}nav{display:flex;gap:36px;font-size:13px;line-height:normal;color:var(--muted)}nav .active{color:var(--plum);font-weight:600;border-bottom:2px solid var(--plum);padding-bottom:8px;margin-bottom:-10px}footer{position:fixed;bottom:0;left:50%;transform:translateX(-50%);width:calc(100% - 160px);max-width:1312px;height:44px;display:flex;align-items:center;justify-content:space-between;border-top:1px solid var(--line);background:#fff;z-index:10;font-size:13px;font-weight:500;color:var(--muted)}footer a{display:flex;align-items:center;min-height:44px}footer a:last-child{color:var(--plum)}.skip{position:fixed;transform:translateY(-200%);background:white;padding:10px;z-index:20}.skip:focus{transform:none}
main{padding:56px 0 40px}h1{font:400 64px/64px Newsreader,Georgia,serif;letter-spacing:-1.8px}.intro{color:var(--muted);margin-top:20px;max-width:52ch}.work-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:48px 32px;margin-top:44px}.work-card{display:block;border-bottom:1px solid var(--line);padding-bottom:28px}.private-preview{aspect-ratio:16/10;background:#f7f0f5;border:1px solid var(--line);border-radius:12px;margin-bottom:24px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:16px;color:var(--plum);font-size:14px}.private-preview span:first-child{font-size:40px}.work-card img{display:block;width:100%;height:auto;aspect-ratio:16/10;object-fit:cover;object-position:top;border-radius:12px;margin-bottom:24px}.client{font-size:11px;line-height:18px;letter-spacing:1.5px;text-transform:uppercase;color:var(--plum);margin-bottom:12px}.work-card h2{font:400 34px/38px Newsreader,Georgia,serif;margin-bottom:14px}.work-card p:not(.client){color:var(--muted);font-size:15px;line-height:24px}.read{display:inline-block;color:var(--plum);font-size:13px;margin-top:18px}.work-card:hover{text-decoration:none}.work-card:hover h2{text-decoration:underline;text-decoration-thickness:1px;text-underline-offset:5px}@media(max-width:1200px){.page{padding:0 40px}footer{width:calc(100% - 80px)}}@media(max-width:760px){body{padding-bottom:0}.page{padding:0 22px}header{height:76px}.wordmark{font-size:18px}nav{gap:20px}main{padding-top:30px}h1{font-size:44px;line-height:46px}.intro{font-size:16px;line-height:26px}.work-grid{grid-template-columns:1fr;gap:32px;margin-top:32px}.work-card h2{font-size:30px;line-height:34px}footer{position:static;transform:none;width:100%;margin-top:24px;height:48px}}</style></body></html>