---
import PageHead from '../components/PageHead.astro';
import PortfolioHeader from '../components/PortfolioHeader.astro';
import PortfolioFooter from '../components/PortfolioFooter.astro';
import '@fontsource-variable/inter';
import CaseStudyScreens from '../components/CaseStudyScreens.astro';
import fluidDashboard from '../assets/work/fluidlogic/dashboard.png';
import fluidHistory from '../assets/work/fluidlogic/activity-history.svg';
import fluidActivity from '../assets/work/fluidlogic/activity-detail.png';
const fluidScreens = [{src:fluidDashboard,alt:'FluidLogic dashboard with an activity plan and device sync confirmation'},{src:fluidHistory,alt:'FluidLogic activity history'},{src:fluidActivity,alt:'FluidLogic individual activity details'}];
const projects = [
 {id:'lotic',client:'Lotic',category:'Human-centered AI',role:'Product & Design Lead',href:'/work/lotic',title:'Making AI feel more human.',body:'I shaped a conversational wellbeing experience around trust, choice, and learning—taking the product from concept to a shipped MVP in 90 days.',evidence:'27% increase in prompt completion over the Alpha',aside:'The important part? Giving people a choice in how they share. That is where trust starts.',imageAlt:'Lotic wellbeing app screens showing prompts, personal insights, and financial wellbeing'},
 {id:'fluidlogic',client:'FluidLogic',category:'Connected products',role:'Product strategy & design direction',href:'/work/fluidlogic',title:'Connected hydration. Focused on the activity.',body:'I connected product strategy, app design, and the marketing experience to help people prepare their hydration plan, use the device, and review their activity.',evidence:'Launched in 2025',aside:'The app sets the plan. The device takes it from there, so people can stay focused on the activity.',imageAlt:'FluidLogic app designs showing the dashboard, activity history, and post-activity details'},
 {id:'amazon',client:'Amazon',category:'Publishing systems',role:'Lead UX Designer',href:'/work/amazon-convergence',title:'Three publishing tools. One coherent experience.',body:'I led research and information architecture to unify fragmented tools around how publishers work—and challenged where preserving features would preserve friction.',evidence:'Three platforms brought into one publishing experience',aside:'Deanna likes finding the underlying knot. Here, that meant questioning which problems were worth carrying forward.',imageAlt:'Amazon book publishing interface showing a unified title detail page'},
];
---
<!doctype html>
<html lang="en">
<PageHead title="Deanna Glaze — Product Design Leader" description="Meet Deanna Glaze through her work in publishing, connected products, and human-centered AI." />
<body>
<a class="skip" href="#work">Skip to selected work</a>
<div class="page">
<PortfolioHeader active="home" />
<main>
<section class="intro"><h1>Good design makes the<br class="desktop-break"/> complicated feel clear.</h1></section>
<section id="work" aria-label="Selected work">
<div class="section-heading"><span>Selected work</span></div><div class="projects">
{projects.map(p=><article class:list={['project',{'selected':p.id==='lotic'}]} data-project={p.id}>
<button class="preview" aria-label={`Preview ${p.client} case study`} aria-expanded={p.id==='lotic'?'true':'false'} aria-controls={`abstract-${p.id}`} data-select={p.id}><span class="art-crop"><img src={p.id==='fluidlogic'?fluidDashboard.src:`/images/exploration/projects/${p.id}-thumb.webp`} width="192" height="174" alt=""/></span><span class="preview-label">Quick look</span></button>
<h2><button data-select={p.id} aria-controls={`abstract-${p.id}`}>{p.client}</button></h2><p class="category">{p.category}</p><p class="role">{p.role}</p><a class="direct" href={p.href}>Full case study <span aria-hidden="true">↗</span></a>
</article>)}
</div>
<div class="presentation" aria-live="polite" aria-atomic="false">
{projects.map(p=><section id={`abstract-${p.id}`} class="abstract" hidden={p.id!=='lotic'} aria-labelledby={`title-${p.id}`}>
<div class="screen"><div class="copy"><p class="eyebrow">{p.client}</p><h2 id={`title-${p.id}`}>{p.title}</h2><p class="summary">{p.body}</p><a class="cta" href={p.href}>Read full case study <span aria-hidden="true">↗</span></a></div><div class="case-evidence">{p.id==='fluidlogic'?<div class="fluid-feature"><CaseStudyScreens screens={fluidScreens} compact/></div>:<img class="feature-image" src={`/images/exploration/projects/${p.id}-feature.webp`} width="852" height="426" alt={p.imageAlt}/>}<div class="outcome"><p class="metric">{p.id==='lotic'?'27%':p.id==='fluidlogic'?'2025':'3'}</p><p>{p.id==='lotic'?'increase in prompt completion over the Alpha':p.id==='fluidlogic'?'product launch across app and device':'publishing platforms brought into one experience'}</p></div></div></div>
<aside class="host"><div class="monkey-crop"><img src="/images/exploration/monkeyshine-wayfarer.png" alt="Monkeyshine wearing Wayfarer-style glasses"/></div><div><p class="reflection">{p.aside}</p></div></aside>
</section>)}
</div>
</section>
<PortfolioFooter />
</main>
</div>
<script>
const selectors = document.querySelectorAll<HTMLButtonElement>('[data-select]');
function selectProject(id: string) {

 document.querySelectorAll<HTMLElement>('[data-project]').forEach(card=>card.classList.toggle('selected',card.dataset.project===id));
 document.querySelectorAll<HTMLElement>('.abstract').forEach(panel=>panel.hidden=panel.id!==`abstract-${id}`);
 document.querySelectorAll<HTMLButtonElement>('.preview').forEach(button=>button.setAttribute('aria-expanded',String(button.dataset.select===id)));
}
selectors.forEach(button=>button.addEventListener('click',()=>selectProject(button.dataset.select!)));
</script>
<style is:global>
:root{--ink:#29282d;--muted:#66616b;--plum:#853b72;--line:#e4dfe4;--selected:#f7f0f5;--panel:#fdfbfd}
*{box-sizing:border-box}body{margin:0;background:#fff;color:var(--ink);font:15px/1.5 'Inter Variable',Arial,sans-serif;padding-bottom:68px}a{color:inherit;text-decoration:none}a:hover{text-decoration:underline}button{font:inherit;color:inherit;cursor:pointer}a:focus-visible,button:focus-visible{outline:2px solid var(--plum);outline-offset:4px}.page{max-width:1472px;padding:0 80px;margin:auto}header{height:88px;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between}.wordmark{font-size:18px;font-weight:400;letter-spacing:-.2px}nav{display:flex;gap:36px;font-size:13px;color:var(--muted)}nav .active{color:var(--plum);font-weight:500;border-bottom:2px solid var(--plum);padding-bottom:8px;margin-bottom:-10px}h1,h2,p{margin:0}.intro{padding:40px 0 42px}h1{font:400 44px/1.4 'Inter Variable',Arial,sans-serif;letter-spacing:-.02em}.intro p{font-size:18px;line-height:27px;color:var(--muted);margin-top:18px}#work{display:grid;grid-template-columns:340px minmax(0,1fr);column-gap:48px;row-gap:18px}.section-heading{line-height:13px;grid-column:1/-1;display:flex;justify-content:space-between;font-size:11px;letter-spacing:1.5px;text-transform:uppercase;color:var(--muted)}#selection-label{color:var(--plum);letter-spacing:1px}.projects{display:flex;flex-direction:column}.project{height:128px;padding:16px;display:grid;grid-template-columns:64px minmax(0,1fr);column-gap:16px;align-content:center;border-bottom:1px solid var(--line)}.project.selected{background:var(--selected);border-bottom:0;border-left:2px solid var(--plum);padding-left:14px}.preview{grid-row:1/5;border:0;padding:0;background:none;align-self:center;width:64px;height:58px}.preview-label{display:none}.art-crop{display:block;width:64px;height:58px;overflow:hidden;border-radius:10px;position:relative;background:#fff;box-shadow:0 2px 6px rgb(41 40 45 / .10),0 5px 12px rgb(41 40 45 / .04)}.art-crop::after{content:"";position:absolute;inset:0;border:1px solid rgb(41 40 45 / .12);border-radius:inherit;pointer-events:none}.art-crop img{display:block;width:100%;height:100%;object-fit:cover}.project h2{font:400 18px/1.4 'Inter Variable',Arial,sans-serif;margin-bottom:5px}.project h2 button{border:0;background:none;padding:0;font:inherit;text-align:left;width:100%}.selected h2 button{color:var(--plum)}.selected h2 button:after{content:'→';float:right;font:18px 'Inter Variable',sans-serif}.category{font-size:13px;line-height:18px;margin-bottom:5px}.role,.direct{font-size:11px;line-height:16px;color:var(--muted)}.role{margin-bottom:5px}.direct{font-weight:500}.selected .direct{color:var(--plum)}.abstract[hidden]{display:none}.screen{display:flex;gap:24px;align-items:center;padding:32px;min-height:340px;border:1px solid var(--line);border-radius:4px;background:var(--panel)}.copy{flex:1;min-width:0;display:flex;flex-direction:column;align-items:flex-start;gap:16px}.eyebrow{font-size:11px;font-weight:600;letter-spacing:1.5px;text-transform:uppercase;color:var(--plum)}.screen h2{font:400 32px/1.3 'Inter Variable',Arial,sans-serif;letter-spacing:-.015em;max-width:17ch}#title-lotic{max-width:13ch}.summary{font-size:15px;line-height:23px;color:var(--muted)}.cta{height:40px;display:inline-flex;align-items:center;gap:24px;border-radius:4px;background:var(--plum);color:#fff;padding:0 18px;font-size:12px;font-weight:500}.case-evidence{width:284px;flex-shrink:0;display:flex;flex-direction:column;gap:24px}.feature-image{display:block;width:100%;height:auto;aspect-ratio:2;object-fit:cover;border-radius:10px}.outcome{border-top:1px solid var(--line);padding-top:16px;color:var(--muted);font-size:12px;line-height:18px}.metric{font:400 36px/1.2 'Inter Variable',Arial,sans-serif;color:var(--plum);margin-bottom:8px}.host{display:flex;gap:20px;align-items:center;margin-top:16px;padding:0 32px 0 24px}.monkey-crop{flex:0 0 93px;height:111px;overflow:hidden;position:relative}.monkey-crop img{display:block;width:100%;height:100%;object-fit:contain}.human-label{font-size:10px;font-weight:500;letter-spacing:1.2px;text-transform:uppercase;color:var(--plum);margin-bottom:8px}.reflection{font:400 17px/1.65 'Inter Variable',Arial,sans-serif}footer{position:fixed;bottom:0;left:50%;transform:translateX(-50%);width:calc(100% - 160px);max-width:1312px;height:44px;display:flex;align-items:center;justify-content:space-between;border-top:1px solid var(--line);background:#fff;z-index:10;font-size:13px;font-weight:500;color:var(--muted)}footer a{display:flex;align-items:center;min-height:44px}footer a:last-child{color:var(--plum)}.skip{position:fixed;transform:translateY(-200%);background:#fff;padding:10px;z-index:20}.skip:focus{transform:none}
@media(max-width:1200px){.page{padding:0 40px}#work{grid-template-columns:290px minmax(0,1fr);gap:18px 30px}.case-evidence{width:210px}.screen{padding:24px;gap:20px}.screen h2{font-size:30px;line-height:1.35}footer{width:calc(100% - 80px)}}
@media(min-width:761px) and (max-height:800px){.intro{padding-top:24px;padding-bottom:26px}h1{font-size:40px;line-height:1.35}.screen{min-height:310px}.host{margin-top:10px}.monkey-crop{transform:scale(.85);transform-origin:center;margin-block:-8px}}
@media(max-width:1000px){.case-evidence{width:150px}.screen{padding:22px;gap:16px}.screen h2{font-size:28px;line-height:1.35}.reflection{font-size:16px}.host{padding:0;gap:12px}}
@media(max-width:760px){body{padding-bottom:0}.page{padding:0 22px}header{height:76px}nav{gap:20px}.wordmark{font-size:18px}.intro{padding:30px 0}h1{font-size:34px;line-height:1.35;letter-spacing:-.015em}.desktop-break{display:none}.intro p{font-size:16px}#work{display:flex;flex-direction:column;gap:18px}.section-heading{width:100%}.project{height:112px}.screen{flex-direction:column;align-items:stretch;padding:24px}.case-evidence{width:100%;display:grid;grid-template-columns:1fr 1fr;align-items:center;gap:18px}.outcome{padding-top:10px}.host{padding:0;gap:12px}.reflection{font-size:16px;line-height:1.65}footer{position:static;transform:none;width:100%;margin-top:24px;height:48px}.direct{font-size:12px}}
@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important}}
h1,h2,h3{text-wrap:balance}
.fluid-feature .case-screens{margin-bottom:0}
</style></body></html>
