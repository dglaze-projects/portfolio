---
import UtilityLayout from '../../layouts/UtilityLayout.astro';
import { SOCIAL } from '../../data/site';
const linkedin = SOCIAL.find(s=>s.label==='LinkedIn')?.href;
---
<UtilityLayout title="Something went wrong" description="The message didn't go through." active="contact" noindex>
<h1>That didn’t go through.</h1><p>Sorry — the message couldn’t be sent. Please try again, or reach me on {linkedin && <a href={linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>} instead.</p><a class="button" href="/contact">Try again →</a>
</UtilityLayout>
