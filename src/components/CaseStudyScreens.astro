---
import type { ImageMetadata } from 'astro';
interface Props { screens: {src:ImageMetadata;alt:string}[]; compact?: boolean }
const {screens,compact=false}=Astro.props;
---
<div class:list={['case-screens',{'case-screens--compact':compact}]}>
{screens.map(screen=><img src={screen.src.src} width={screen.src.width} height={screen.src.height} alt={screen.alt} loading={compact?'lazy':'eager'}/>)}
</div>
<style>
.case-screens{display:flex;align-items:flex-start;justify-content:center;gap:5%;padding:48px 7%;background:#edf3f5;border:1px solid #e2e9ec;border-radius:16px;margin-bottom:24px;overflow:hidden}
.case-screens img{display:block;width:26%;height:auto;aspect-ratio:auto;object-fit:contain;max-width:290px;border-radius:14px;margin:0;box-shadow:0 10px 26px rgb(10 42 56 / .10)}
.case-screens--compact{aspect-ratio:16/10;padding:6% 7%;border-radius:12px}
.case-screens--compact img{width:27%}
@media(max-width:760px){.case-screens{padding:24px 5%;gap:5%;border-radius:12px}.case-screens img{width:27%;border-radius:6px}.case-screens--compact{padding:6% 7%}}
</style>
