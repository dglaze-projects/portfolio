---
import PageHead from '../components/PageHead.astro';
import PortfolioHeader from '../components/PortfolioHeader.astro';
import PortfolioFooter from '../components/PortfolioFooter.astro';
import '@fontsource-variable/inter';
import { Image } from 'astro:assets';
import { getCollection, type CollectionEntry } from 'astro:content';
interface Props { entry: CollectionEntry<'work'>; noindex?: boolean; hideRole?: boolean; hideNext?: boolean; pageTitle?: string }
const { entry } = Astro.props;
const d = entry.data;
const projects = (await getCollection('work', ({data}) => !data.draft)).sort((a,b) => a.data.order-b.data.order);
const next = projects[(projects.findIndex(p=>p.id===entry.id)+1)%projects.length];
const activities = d.roleActivities.length ? d.roleActivities : d.skills;
---
<!doctype html>
<html lang="en">
<PageHead title={Astro.props.pageTitle || `${d.client}: ${d.title} — Deanna Glaze`} description={d.tagline} noindex={Astro.props.noindex} />
<body><a class="skip" href="#main">Skip to case study</a><div class="page">
<PortfolioHeader active="work" />
<main id="main">
<article>
<div class="introduction">
<a class="back" href="/work">← All work</a>
<div class="overview"><p class="eyebrow">{[d.client, d.category].filter(Boolean).join(" · ")}</p><h1>{d.title}</h1></div>
<div class="intro-summary"><p class="description">{d.description || d.tagline}</p>
{!Astro.props.hideRole && <div class="details"><section><h2 class="eyebrow">My role</h2><p>{d.role}</p>{d.roleSummary && <p>{d.roleSummary}</p>}{activities.map(item=><p>{item}</p>)}</section></div>}
</div>
</div>
{d.cover && <Image class="cover" src={d.cover} alt={d.coverAlt || ''} widths={[768,1312,1968]} sizes="(max-width: 760px) calc(100vw - 44px), (max-width: 1200px) calc(100vw - 80px), 1312px" loading="eager"/>}
<div class:list={['case-body', {'lotic':entry.id==='lotic'}]}><slot/></div>
</article>
{!Astro.props.hideNext && next && next.id!==entry.id && <a class="next-project" href={`/work/${next.id}`}><div><p class="eyebrow">Next project</p><p class="next-title">{`${next.data.client} — ${next.data.shortTitle || next.data.title}`}</p></div><span aria-hidden="true">→</span></a>}
</main>
<PortfolioFooter />
</div></body></html>
<style is:global>
:root{--ink:#29282d;--muted:#66616b;--plum:#853b72;--line:#e4dfe4;--tint:#f7f0f5}*{box-sizing:border-box}body{margin:0;padding-bottom:68px;background:#fff;color:var(--ink);font:18px/29px 'Inter Variable',Arial,sans-serif}.page{max-width:1472px;padding:0 80px;margin:auto}a{color:inherit;text-decoration:none}a:hover{text-decoration:underline}a:focus-visible,button:focus-visible{outline:2px solid var(--plum);outline-offset:5px}h1,h2,h3,p,blockquote,ul,ol{margin:0}.site-header{height:88px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line)}.wordmark{font-size:19px;font-weight:600;letter-spacing:-.6px}nav{display:flex;gap:36px;font-size:13px;line-height:normal;color:var(--muted)}nav .active{color:var(--plum);font-weight:600;border-bottom:2px solid var(--plum);padding-bottom:8px;margin-bottom:-10px}.introduction{padding:32px 0 48px;display:flex;flex-direction:column;gap:32px}.back{font-size:13px;line-height:normal;color:var(--muted);align-self:flex-start}.overview{padding-top:16px;display:flex;flex-direction:column;gap:24px}.eyebrow{font:500 11px/normal 'Inter Variable',Arial,sans-serif;letter-spacing:1.5px;text-transform:uppercase;color:var(--plum)}h1{font:400 72px/74px Newsreader,Georgia,serif;letter-spacing:-1.8px;max-width:1120px}.intro-summary{display:grid;grid-template-columns:minmax(0,1fr) 320px;gap:72px;align-items:start}.description{font-size:20px;line-height:30px;color:var(--muted);max-width:940px}.details{min-width:0}.details .eyebrow{margin-bottom:8px}.details section{display:flex;flex-direction:column;gap:4px;font-size:15px;line-height:21px;color:var(--muted)}.cover{display:block;width:100%;height:auto;border-radius:20px}
.case-body{display:grid;grid-template-columns:220px minmax(0,1fr);column-gap:48px;row-gap:24px;color:var(--muted);padding-bottom:16px}.case-body>*{grid-column:2;min-width:0}.case-body>h2{scroll-margin-top:24px;position:relative;font:400 46px/49px Newsreader,Georgia,serif;letter-spacing:-.8px;color:var(--ink);margin-top:64px}.case-body>h2:first-child{margin-top:72px}.case-body>h2::before{content:'';position:absolute;width:40px;height:1px;background:var(--plum);left:-268px;top:8px}.case-body>h2:has(+h3){grid-column:1;font:500 11px/18px 'Inter Variable',Arial,sans-serif;letter-spacing:1.5px;text-transform:uppercase;color:var(--plum);padding-top:25px;align-self:start}.case-body>h2:has(+h3)::before{left:0}.case-body>h3{font:400 46px/49px Newsreader,Georgia,serif;letter-spacing:-.8px;color:var(--ink);margin-top:64px}.case-body>h2:first-child+h3{margin-top:72px}.case-body strong{color:var(--ink);font-weight:600}.case-body a{color:var(--plum);text-decoration:underline}.case-body blockquote{padding:28px 32px;border-left:2px solid var(--plum);background:var(--tint);display:flex;flex-direction:column;gap:20px}.case-body blockquote p{font:400 29px/36px Newsreader,Georgia,serif;color:var(--ink)}.case-body blockquote p+p{font:400 16px/26px 'Inter Variable',Arial,sans-serif;color:var(--muted)}.case-body img{display:block;width:100%;height:auto;border-radius:12px}.case-body ul,.case-body ol{padding-left:24px}.case-body li+li{margin-top:12px}.case-body.lotic>ul,.case-body>.metrics{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:32px;padding:0;list-style:none}.case-body.lotic>ul li,.case-body>.metrics li{border-top:1px solid var(--line);padding-top:20px;margin:0;font-size:15px;line-height:24px}.case-body.lotic>ul strong,.case-body .metrics__value{display:block;font:400 54px/54px Newsreader,Georgia,serif;color:var(--plum);margin-bottom:12px}.case-body>.metrics{grid-template-columns:repeat(2,minmax(0,1fr))}.case-body .metrics__label{display:block}.case-body>video{width:100%;height:auto;max-height:816px;object-fit:contain;background:#fdfbfd;padding:40px;border-radius:0}.next-project{margin-top:88px;padding:32px 0;display:flex;justify-content:space-between;gap:24px;align-items:center;border-block:1px solid var(--line)}.next-project .eyebrow{color:var(--muted);margin-bottom:16px}.next-title{font:400 34px/40px Newsreader,Georgia,serif}.next-project>span{font-size:28px;color:var(--plum)}footer{position:fixed;bottom:0;left:50%;transform:translateX(-50%);width:calc(100% - 160px);max-width:1312px;height:44px;display:flex;align-items:center;justify-content:space-between;border-top:1px solid var(--line);background:#fff;z-index:10;font-size:13px;font-weight:500;color:var(--muted)}footer a{display:flex;align-items:center;min-height:44px}footer a:last-child{color:var(--plum)}.skip{position:fixed;transform:translateY(-200%);background:white;padding:10px;z-index:20}.skip:focus{transform:none}
.lightbox-trigger{position:relative;display:block;width:100%;border:0;padding:0;background:none;cursor:zoom-in}.lightbox-trigger::after{content:'↗';position:absolute;bottom:12px;right:12px;padding:2px 8px;border-radius:4px;background:var(--plum);color:#fff}.lightbox{border:0;padding:24px;background:#fff;border-radius:12px;max-width:94vw;max-height:94vh}.lightbox:popover-open{display:flex;align-items:center;justify-content:center}.case-body .lightbox img{width:auto;height:auto;max-width:calc(94vw - 48px);max-height:calc(94vh - 48px);object-fit:contain}.lightbox::backdrop{background:rgb(25 20 28 / .8)}.lightbox__close{position:absolute;top:8px;right:8px;border:0;background:var(--plum);color:white;border-radius:50%;width:36px;height:36px;font-size:24px;cursor:pointer}
@media(max-width:1200px){.intro-summary{grid-template-columns:minmax(0,1fr) 280px;gap:40px}.page{padding:0 40px}.case-body{grid-template-columns:160px minmax(0,1fr);column-gap:32px}.case-body>h2::before{left:-192px}footer{width:calc(100% - 80px)}h1{font-size:60px;line-height:64px}}
@media(max-width:760px){body{padding-bottom:0}.page{padding:0 22px}.site-header{height:76px}.wordmark{font-size:18px}nav{gap:20px}.introduction{padding:28px 0 32px;gap:24px}.overview{padding-top:0}h1{font-size:44px;line-height:46px;letter-spacing:-1px}.description{font-size:17px;line-height:28px}.intro-summary{grid-template-columns:1fr;gap:28px}.cover{border-radius:12px}.case-body{display:flex;flex-direction:column;gap:20px;font-size:16px;line-height:27px}.case-body>h2,.case-body>h3{font-size:34px;line-height:38px;margin-top:40px}.case-body>h2:first-child{margin-top:40px}.case-body>h2:has(+h3){width:100%;margin-top:40px}.case-body>h2+h3,.case-body>h2:first-child+h3{margin-top:0}.case-body>h2::before{left:0;top:-16px}.case-body>h2:has(+h3)::before{top:8px}.case-body blockquote{padding:22px}.case-body blockquote p{font-size:25px;line-height:32px}.case-body.lotic>ul,.case-body>.metrics{grid-template-columns:1fr;gap:24px}.case-body>video{padding:20px;max-height:650px}.next-project{margin-top:48px}.next-title{font-size:28px;line-height:34px}footer{position:static;transform:none;width:100%;margin-top:24px;height:48px}}
</style>
