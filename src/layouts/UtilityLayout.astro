---
import '@fontsource-variable/inter';
import PageHead from '../components/PageHead.astro';
import PortfolioHeader from '../components/PortfolioHeader.astro';
import PortfolioFooter from '../components/PortfolioFooter.astro';
interface Props { title: string; description?: string; noindex?: boolean; active?: 'work' | 'about' | 'contact' }
const {title,description,noindex=false,active}=Astro.props;
---
<!doctype html><html lang="en"><PageHead title={`${title} — Deanna Glaze`} description={description} noindex={noindex}/><body><a class="skip" href="#main">Skip to content</a><div class="page"><PortfolioHeader active={active}/><main id="main"><slot/></main><PortfolioFooter/></div></body></html>
<style is:global>
:root{--ink:#29282d;--muted:#66616b;--plum:#853b72;--line:#e4dfe4}*{box-sizing:border-box}body{margin:0;padding-bottom:68px;background:white;color:var(--ink);font:18px/29px 'Inter Variable',Arial,sans-serif}.page{max-width:1472px;padding:0 80px;margin:auto}a{color:var(--plum);text-underline-offset:4px}a:focus-visible{outline:2px solid var(--plum);outline-offset:5px}.site-header{height:88px;display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid var(--line)}.wordmark{color:var(--ink);font-size:19px;font-weight:600;letter-spacing:-.6px;text-decoration:none}nav{display:flex;gap:36px;font-size:13px;line-height:normal}nav a{color:var(--muted);text-decoration:none}nav .active{color:var(--plum);font-weight:600;border-bottom:2px solid var(--plum);padding-bottom:8px;margin-bottom:-10px}main{padding:56px 0 64px;max-width:940px}h1{font:400 64px/64px Newsreader,Georgia,serif;letter-spacing:-1.8px;margin:0 0 28px}p{color:var(--muted);margin:0 0 24px}.button{display:inline-flex;align-items:center;background:var(--plum);color:white;padding:0 20px;height:44px;border-radius:4px;font-size:13px;text-decoration:none}footer{position:fixed;bottom:0;left:50%;transform:translateX(-50%);width:calc(100% - 160px);max-width:1312px;height:44px;display:flex;justify-content:space-between;align-items:center;background:white;border-top:1px solid var(--line);font-size:13px;font-weight:500}footer a{display:flex;align-items:center;min-height:44px;text-decoration:none;color:var(--muted)}footer a:last-child{color:var(--plum)}.skip{position:fixed;transform:translateY(-200%);background:white;padding:10px;z-index:20}.skip:focus{transform:none}@media(max-width:1200px){.page{padding:0 40px}footer{width:calc(100% - 80px)}}@media(max-width:760px){body{padding-bottom:0}.page{padding:0 22px}.site-header{height:76px}.wordmark{font-size:18px}nav{gap:20px}main{padding:30px 0}h1{font-size:44px;line-height:46px;letter-spacing:-1px}footer{position:static;transform:none;width:100%;margin-top:24px;height:48px}}
</style>
